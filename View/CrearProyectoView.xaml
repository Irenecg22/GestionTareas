<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.CrearProyectoView"
             x:DataType="vm:CrearProyectoViewModel"
             Title="Nuevo Proyecto"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Nuevo Proyecto"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#111827" />

            <Border BackgroundColor="#F3F4F6"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="20">

                <VerticalStackLayout Spacing="18">

                    <Label Text="Nombre"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="#374151" />

                    <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                        <Entry Text="{Binding Nombre}"
                           Placeholder="Escribe el nombre del proyecto"
                           BackgroundColor="Transparent"
                           TextColor="#111827"
                           PlaceholderColor="#9CA3AF" />
                    </Border>

                    <Label Text="Descripción"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="#374151" />

                    <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                        <Editor Text="{Binding Descripcion}"
                            Placeholder="Escribe la descripción"
                            BackgroundColor="Transparent"
                            TextColor="#111827"
                            PlaceholderColor="#9CA3AF"
                            HeightRequest="120"
                            AutoSize="TextChanges" />
                    </Border>

                    <Label Text="Fecha de creación"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="#374151" />

                    <Border BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                        <DatePicker Date="{Binding FechaCreacion}"
                                BackgroundColor="Transparent"
                                TextColor="#111827" />
                    </Border>

                    <Button Text="Crear"
                        Command="{Binding CrearProyectoCommand}"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="52"
                        Margin="0,12,0,0" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>