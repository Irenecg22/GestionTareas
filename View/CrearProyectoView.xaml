<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.CrearProyectoView"
             x:DataType="vm:CrearProyectoViewModel"
             Title="Nuevo Proyecto"
             BackgroundColor="#F9FAFB">

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
            <Label Text="Crear Proyecto" FontSize="26" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center"/>
            <Label Text="Define los parámetros del nuevo proyecto" FontSize="14" TextColor="#6B7280" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="White" Padding="20">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.05" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Nombre del Proyecto" FontSize="13" FontAttributes="Bold" TextColor="#374151" Margin="4,0"/>
                    <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" BackgroundColor="#F3F4F6" Padding="12,2">
                        <Entry Text="{Binding Nombre}" Placeholder="Ej: App Móvil MAUI" PlaceholderColor="#9CA3AF" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Fecha de Inicio" FontSize="13" FontAttributes="Bold" TextColor="#374151" Margin="4,0"/>
                    <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" BackgroundColor="#F3F4F6" Padding="12,0">
                        <DatePicker Date="{Binding FechaCreacion}" TextColor="#111827" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Descripción" FontSize="13" FontAttributes="Bold" TextColor="#374151" Margin="4,0"/>
                    <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" BackgroundColor="#F3F4F6" Padding="12,2">
                        <Editor Text="{Binding Descripcion}" Placeholder="Objetivos del proyecto..." HeightRequest="80" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Crear Proyecto" 
                        Command="{Binding CrearProyectoCommand}"
                        BackgroundColor="#7C3AED" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        HeightRequest="48" 
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>