<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.CrearTareaView"
             x:DataType="vm:CrearTareaViewModel"
             Title="Nueva Tarea"
             BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#0F0F12}">

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
            <Label Text="Nueva Tarea" FontSize="26" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#111827, Dark=White}" HorizontalTextAlignment="Center"/>
            <Label Text="Crea una nueva tarea en tu proyecto" FontSize="14" 
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" 
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" Padding="20">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=Black, Dark=Transparent}" Offset="0,2" Radius="10" Opacity="0.05" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <!-- Título -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Título" FontSize="13" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" Margin="4,0"/>
                    <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" StrokeShape="RoundRectangle 12" 
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" Padding="12,2">
                        <Entry Text="{Binding Titulo}" Placeholder="Ej: Diseño de UI" PlaceholderColor="#9CA3AF" 
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Proyecto -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Proyecto" FontSize="13" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" Margin="4,0"/>
                    <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" StrokeShape="RoundRectangle 12" 
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" Padding="12,0">
                        <Picker ItemsSource="{Binding ProyectosDisponibles}"
                                ItemDisplayBinding="{Binding Nombre}"
                                SelectedItem="{Binding ProyectoSeleccionado}"
                                Title="Seleccionar proyecto"
                                TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                TitleColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Descripción -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Descripción" FontSize="13" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" Margin="4,0"/>
                    <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" StrokeShape="RoundRectangle 12" 
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" Padding="12,2">
                        <Editor Text="{Binding Descripcion}" Placeholder="Breve resumen..." HeightRequest="100" 
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Info estado -->
                <HorizontalStackLayout Spacing="8" Margin="4,0">
                    <Label Text="ℹ️" FontSize="12"/>
                    <Label Text="La tarea se creará con estado 'Pendiente' y sin asignar" 
                           FontSize="11" 
                           TextColor="#9CA3AF"/>
                </HorizontalStackLayout>

                <Button Text="Crear Tarea" 
                        Command="{Binding CrearTareaCommand}"
                        BackgroundColor="#7C3AED" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        HeightRequest="48" 
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>