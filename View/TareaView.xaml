<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             xmlns:model="clr-namespace:GestionTareas.Model"
             x:Class="GestionTareas.View.TareaView"
             x:DataType="vm:TareaViewModel"
             x:Name="ThisPage"
             Title="Tareas"
             BackgroundColor="{AppThemeBinding Light=#EEF0F6, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" 
                BackgroundColor="#4F46E5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,32,32"
                Padding="20,15">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="#635BFF">
                        <Label Text="✓" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mis Tareas" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Organiza tu trabajo diario" FontSize="12" TextColor="#E9E7FF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button Text="+ Nueva tarea" BackgroundColor="#9333EA" Clicked="OnNuevaTareaClicked"
                        TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Margin="16,10" 
                BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#1E1B4B}" 
                StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tablero General" FontSize="14" FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#1F2937, Dark=White}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Tareas.Count, StringFormat='Total: {0}'}" 
                       FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}" VerticalOptions="Center" />
            </Grid>
        </Border>

       
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*" 
              Padding="10" 
              ColumnSpacing="10"
              IsVisible="{OnIdiom Default=True, Phone=False}">

           
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}" 
                        Padding="8" 
                        StrokeShape="RoundRectangle 10">
                    <Label Text="To Do" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                </Border>

                <CollectionView Grid.Row="1" 
                                ItemsSource="{Binding TareasPendientes}"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,12" 
                                    Padding="0" 
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 15" 
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E26}"
                                    HorizontalOptions="Fill">
                                <Border.Shadow>
                                    <Shadow Brush="#6A5ACD" Offset="0,4" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="8, *, Auto">
                                    <BoxView Grid.Column="0" 
                                             BackgroundColor="#8A2BE2" 
                                             VerticalOptions="Fill" />

                                    <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="4">
                                        <Label Text="{Binding Titulo}" 
                                               FontSize="15" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#4B0082, Dark=#D8BFD8}" />

                                        <Label Text="{Binding Descripcion}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#A9A9B3}" 
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,6,0,0">
                                            <Border BackgroundColor="#F3E5F5" 
                                                    StrokeShape="RoundRectangle 10" 
                                                    Padding="6,2">
                                                <Label Text="{Binding ProyectoDisplay}" 
                                                       FontSize="10" 
                                                       TextColor="#7B1FA2" 
                                                       FontAttributes="Bold"/>
                                            </Border>

                                            <Border BackgroundColor="#E8F4FD" 
                                                    StrokeShape="RoundRectangle 10" 
                                                    Padding="6,2">
                                                <Label FontSize="10" TextColor="#1976D2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Asignado: " FontAttributes="None" />
                                                            <Span Text="{Binding AsignadoDisplay}" FontAttributes="Bold" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <StackLayout Grid.Column="2" 
                                                 BackgroundColor="{AppThemeBinding Light=#F9F5FF, Dark=#252530}" 
                                                 Padding="8" 
                                                 VerticalOptions="Fill"
                                                 Spacing="8">
                                        <Button Text="✏️" 
                                                WidthRequest="32" 
                                                HeightRequest="32"
                                                CornerRadius="16"
                                                BackgroundColor="Transparent"
                                                TextColor="#8A2BE2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarTareaCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Text="🗑️" 
                                                WidthRequest="32" 
                                                HeightRequest="32"
                                                CornerRadius="16"
                                                BackgroundColor="Transparent"
                                                TextColor="#FF4B4B"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarTareaCommand}"
                                                CommandParameter="{Binding .}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

           
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
