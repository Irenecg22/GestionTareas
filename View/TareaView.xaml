<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             xmlns:model="clr-namespace:GestionTareas.Model"
             x:Class="GestionTareas.View.TareaView"
             x:DataType="vm:TareaViewModel"
             x:Name="ThisPage"
             Title="Tareas"
             BackgroundColor="#EEF0F6">

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" 
                BackgroundColor="#4F46E5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,32,32"
                Padding="20,15">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="#635BFF">
                        <Label Text="✓" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mis Tareas" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Organiza tu trabajo diario" FontSize="12" TextColor="#E9E7FF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button Text="+ Nueva tarea" BackgroundColor="#9333EA" Clicked="OnNuevaTareaClicked"
                        TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Margin="16,10" BackgroundColor="#F3F0FF" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tablero General" FontSize="14" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Tareas.Count, StringFormat='Total: {0}'}" 
                       FontAttributes="Bold" TextColor="#6D28D9" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="10" ColumnSpacing="8">

            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="#E5E7EB" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="To Do" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#374151" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasPendientes}" Margin="0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,8" Padding="8" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Titulo}" FontSize="12" FontAttributes="Bold" MaxLines="1" />
                                    <Label Text="{Binding Descripcion}" FontSize="10" TextColor="Gray" MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="#FEF3C7" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="Doing" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#92400E" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasEnProgreso}" Margin="0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,8" Padding="8" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Titulo}" FontSize="12" FontAttributes="Bold" MaxLines="1" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="#D1FAE5" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="Done" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#065F46" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasCompletadas}" Margin="0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,8" Padding="8" BackgroundColor="White" StrokeShape="RoundRectangle 10" Opacity="0.7">
                                <Label Text="{Binding Titulo}" FontSize="11" TextDecorations="Strikethrough" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>