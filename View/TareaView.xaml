<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             xmlns:model="clr-namespace:GestionTareas.Model"
             x:Class="GestionTareas.View.TareaView"
             x:DataType="vm:TareaViewModel"
             x:Name="ThisPage"
             Title="Tareas"
             BackgroundColor="{AppThemeBinding Light=#EEF0F6, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" 
                BackgroundColor="#4F46E5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,32,32"
                Padding="20,15">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="#635BFF">
                        <Label Text="✓" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mis Tareas" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Organiza tu trabajo diario" FontSize="12" TextColor="#E9E7FF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button Text="+ Nueva tarea" BackgroundColor="#9333EA" Clicked="OnNuevaTareaClicked"
                        TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Margin="16,10" 
                BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#1E1B4B}" 
                StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tablero General" FontSize="14" FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#1F2937, Dark=White}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Tareas.Count, StringFormat='Total: {0}'}" 
                       FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="10" ColumnSpacing="8">

            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="To Do" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" 
                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasPendientes}" Margin="15,10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,15" 
                    Padding="0" 
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E26}">
                                <Border.Shadow>
                                    <Shadow Brush="#6A5ACD" Offset="0,4" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="8, *, Auto">
                                    <BoxView Grid.Column="0" 
                             BackgroundColor="#8A2BE2" 
                             VerticalOptions="Fill" />

                                    <VerticalStackLayout Grid.Column="1" Padding="15" Spacing="4">
                                        <Label Text="{Binding Titulo}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#4B0082, Dark=#D8BFD8}" />

                                        <Label Text="{Binding Descripcion}" 
                               FontSize="13" 
                               TextColor="{AppThemeBinding Light=#666666, Dark=#A9A9B3}" 
                               MaxLines="2" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,8,0,0">
                                            <Border BackgroundColor="#F3E5F5" 
                                    StrokeShape="RoundRectangle 10" 
                                    Padding="8,2">
                                                <Label Text="{Binding ProyectoDisplay}" 
                                                       FontSize="11" 
                                                       TextColor="#7B1FA2" 
                                                       FontAttributes="Bold"/>
                                            </Border>

                                            <Border BackgroundColor="#E8F4FD" 
                                    StrokeShape="RoundRectangle 10" 
                                    Padding="8,2">
                                                <Label FontSize="11" TextColor="#1976D2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Asignado: " FontAttributes="None" />
                                                            <Span Text="{Binding AsignadoDisplay}" FontAttributes="Bold" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <StackLayout Grid.Column="2" 
                                 BackgroundColor="{AppThemeBinding Light=#F9F5FF, Dark=#252530}" 
                                 Padding="10" 
                                 VerticalOptions="Fill"
                                 Spacing="10">
                                        <Button Text="✏️" 
                                WidthRequest="36" HeightRequest="36"
                                CornerRadius="18"
                                BackgroundColor="Transparent"
                                TextColor="#8A2BE2"
                                Command="{Binding BindingContext.EditarTareaCommand, Source={x:Reference ThisPage}}"
                                CommandParameter="{Binding .}" />

                                        <Button Text="🗑️" 
                                WidthRequest="36" HeightRequest="36"
                                CornerRadius="18"
                                BackgroundColor="Transparent"
                                TextColor="#FF4B4B"
                                Command="{Binding BindingContext.EliminarTareaCommand, Source={x:Reference ThisPage}}"
                                CommandParameter="{Binding .}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#451A03}" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="Doing" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" 
                   TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasEnProgreso}" Margin="0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,15" 
 Padding="0" 
 StrokeThickness="2"
 StrokeShape="RoundRectangle 15" 
 BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E26}">
                                <Border.Shadow>
                                    <Shadow Brush="#6A5ACD" Offset="0,4" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="8, *, Auto">
                                    <BoxView Grid.Column="0" 
          BackgroundColor="#8A2BE2" 
          VerticalOptions="Fill" />

                                    <VerticalStackLayout Grid.Column="1" Padding="15" Spacing="4">
                                        <Label Text="{Binding Titulo}" 
            FontSize="16" 
            FontAttributes="Bold" 
            TextColor="{AppThemeBinding Light=#4B0082, Dark=#D8BFD8}" />

                                        <Label Text="{Binding Descripcion}" 
            FontSize="13" 
            TextColor="{AppThemeBinding Light=#666666, Dark=#A9A9B3}" 
            MaxLines="2" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,8,0,0">
                                            <Border BackgroundColor="#F3E5F5" 
                 StrokeShape="RoundRectangle 10" 
                 Padding="8,2">
                                                <Label Text="{Binding ProyectoDisplay}" 
                                                       FontSize="11" 
                                                       TextColor="#7B1FA2" 
                                                       FontAttributes="Bold"/>
                                            </Border>

                                            <Border BackgroundColor="#E8F4FD" 
                 StrokeShape="RoundRectangle 10" 
                 Padding="8,2">
                                                <Label FontSize="11" TextColor="#1976D2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Asignado: " FontAttributes="None" />
                                                            <Span Text="{Binding AsignadoDisplay}" FontAttributes="Bold" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <StackLayout Grid.Column="2" 
              BackgroundColor="{AppThemeBinding Light=#F9F5FF, Dark=#252530}" 
              Padding="10" 
              VerticalOptions="Fill"
              Spacing="10">
                                        <Button Text="✏️" 
             WidthRequest="36" HeightRequest="36"
             CornerRadius="18"
             BackgroundColor="Transparent"
             TextColor="#8A2BE2"
             Command="{Binding BindingContext.EditarTareaCommand, Source={x:Reference ThisPage}}"
             CommandParameter="{Binding .}" />

                                        <Button Text="🗑️" 
             WidthRequest="36" HeightRequest="36"
             CornerRadius="18"
             BackgroundColor="Transparent"
             TextColor="#FF4B4B"
             Command="{Binding BindingContext.EliminarTareaCommand, Source={x:Reference ThisPage}}"
             CommandParameter="{Binding .}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#D1FAE5, Dark=#064E3B}" Padding="5" StrokeShape="RoundRectangle 10">
                    <Label Text="Done" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" 
                   TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}" />
                </Border>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TareasCompletadas}" Margin="0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Tarea">
                            <Border Margin="0,0,0,15" 
 Padding="0" 
 StrokeThickness="2"
 StrokeShape="RoundRectangle 15" 
 BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E26}">
                                <Border.Shadow>
                                    <Shadow Brush="#6A5ACD" Offset="0,4" Radius="8" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="8, *, Auto">
                                    <BoxView Grid.Column="0" 
          BackgroundColor="#8A2BE2" 
          VerticalOptions="Fill" />

                                    <VerticalStackLayout Grid.Column="1" Padding="15" Spacing="4">
                                        <Label Text="{Binding Titulo}" 
            FontSize="16" 
            FontAttributes="Bold" 
            TextColor="{AppThemeBinding Light=#4B0082, Dark=#D8BFD8}" />

                                        <Label Text="{Binding Descripcion}" 
            FontSize="13" 
            TextColor="{AppThemeBinding Light=#666666, Dark=#A9A9B3}" 
            MaxLines="2" />

                                        <HorizontalStackLayout Spacing="6" Margin="0,8,0,0">
                                            <Border BackgroundColor="#F3E5F5" 
                 StrokeShape="RoundRectangle 10" 
                 Padding="8,2">
                                                <Label Text="{Binding ProyectoDisplay}" 
                                                       FontSize="11" 
                                                       TextColor="#7B1FA2" 
                                                       FontAttributes="Bold"/>
                                            </Border>

                                            <Border BackgroundColor="#E8F4FD" 
                 StrokeShape="RoundRectangle 10" 
                 Padding="8,2">
                                                <Label FontSize="11" TextColor="#1976D2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Asignado: " FontAttributes="None" />
                                                            <Span Text="{Binding AsignadoDisplay}" FontAttributes="Bold" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <StackLayout Grid.Column="2" 
              BackgroundColor="{AppThemeBinding Light=#F9F5FF, Dark=#252530}" 
              Padding="10" 
              VerticalOptions="Fill"
              Spacing="10">
                                        <Button Text="✏️" 
             WidthRequest="36" HeightRequest="36"
             CornerRadius="18"
             BackgroundColor="Transparent"
             TextColor="#8A2BE2"
             Command="{Binding BindingContext.EditarTareaCommand, Source={x:Reference ThisPage}}"
             CommandParameter="{Binding .}" />

                                        <Button Text="🗑️" 
             WidthRequest="36" HeightRequest="36"
             CornerRadius="18"
             BackgroundColor="Transparent"
             TextColor="#FF4B4B"
             Command="{Binding BindingContext.EliminarTareaCommand, Source={x:Reference ThisPage}}"
             CommandParameter="{Binding .}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>