<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.ProyectoDetalleView"
             Title="ProyectoDetalleView">

    <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="{Binding Proyecto.Nombre}"
               FontSize="22"
               FontAttributes="Bold"/>

            <Label Text="{Binding Proyecto.Descripcion}"
               FontSize="16"/>

        </VerticalStackLayout>
    </ContentPage>