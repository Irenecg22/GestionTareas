<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             xmlns:model="clr-namespace:GestionTareas.Model"
             x:DataType="vm:ProyectoDetalleViewModel"
             x:Class="GestionTareas.View.ProyectoDetalleView"
             x:Name="thisPage"
             Title="Detalles"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,30,30" HeightRequest="180">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.1" />
                    <GradientStop Color="#7C3AED" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Padding="25" RowDefinitions="*, Auto">
                <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                    <Label Text="{Binding Proyecto.Nombre}" 
                           FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="White" Opacity="0.2" Padding="8,2" StrokeShape="RoundRectangle 6">
                            <Label Text="{Binding Proyecto.Id, StringFormat='ID: {0}'}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                        </Border>
                        <Label Text="{Binding Proyecto.FechaCreacion, StringFormat='📅 {0}'}" 
                               TextColor="#E0E7FF" FontSize="12" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="25">

                <VerticalStackLayout Spacing="8">
                    <Label Text="DESCRIPCIÓN" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1"/>
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            Padding="20" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                        <Label Text="{Binding Proyecto.Descripcion}" 
                               TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontSize="15" LineHeight="1.4"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="TAREAS DEL EQUIPO" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1"/>

                        <Label Grid.Column="1" Text="{Binding TareasFiltradas.Count, StringFormat='{0} asignadas'}" 
                               FontSize="11" TextColor="#7C3AED" FontAttributes="Bold"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TareasFiltradas}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:Tarea">
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                                        StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.03" />
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <BoxView WidthRequest="5" CornerRadius="2.5" VerticalOptions="Fill">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Completada">
                                                    <Setter Property="Color" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="En Progreso">
                                                    <Setter Property="Color" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Pendiente">
                                                    <Setter Property="Color" Value="#64748B"/>
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" 
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="14"/>
                                            <Label Text="{Binding Descripcion}" TextColor="#94A3B8" FontSize="12" MaxLines="1"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2" Padding="10,5" StrokeShape="RoundRectangle 8" StrokeThickness="0" 
                                                VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2D2D35}">
                                            <Label Text="{Binding Estado}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="MIEMBROS" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1"/>
                        <Label Grid.Column="1" Text="{Binding Miembros.Count, StringFormat='{0} miembros'}" 
                               FontSize="11" TextColor="#7C3AED" FontAttributes="Bold"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Miembros}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:ProyectoUsuario">
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding NombreMostrar}" 
                                                   FontAttributes="Bold" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"/>

                                            <Label Text="{Binding EmailMostrar}" 
                                                   FontSize="11" 
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                                   IsVisible="{Binding TieneEmail}"/>

                                            <Label Text="{Binding RolProyectoDisplay}" 
                                                   FontSize="12" 
                                                   TextColor="#7C3AED" 
                                                   FontAttributes="Bold"/>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1" Text="✏️" 
                                                WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                                BackgroundColor="Transparent"
                                                Command="{Binding BindingContext.UpdateRolMiembroCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>

                                        <Button Grid.Column="2" Text="🗑️" 
                                                WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                                BackgroundColor="Transparent"
                                                Command="{Binding BindingContext.RemoveMiembroCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#1E1B4B}" 
                            StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Añadir miembro" FontSize="13" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#4C1D95, Dark=#A78BFA}"/>
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Entry Placeholder="Email del usuario" Keyboard="Email"
                                       Text="{Binding InputEmail}"/>
                                <Picker Grid.Column="1" 
                                        ItemsSource="{Binding RolesProyectoDisplay}" 
                                        SelectedItem="{Binding InputRolDisplay}"
                                        Title="Rol"/>
                            </Grid>
                            <Button Text="+ Añadir miembro" 
                                    Command="{Binding AddMiembroCommand}"
                                    BackgroundColor="#7C3AED" TextColor="White" 
                                    FontAttributes="Bold" CornerRadius="10" HeightRequest="40"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>