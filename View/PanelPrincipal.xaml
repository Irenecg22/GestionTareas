<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.PanelPrincipal"
             Title="Dashboard"
             BackgroundColor="#F0F2F8">

    <ScrollView>
        <VerticalStackLayout Spacing="18">

            <!-- CABECERA -->
            <Border BackgroundColor="#4834D4"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,40,40"
                    Padding="20">

                <HorizontalStackLayout Spacing="16"
                                       VerticalOptions="Center">

                    <Frame HeightRequest="70"
                           WidthRequest="70"
                           CornerRadius="35"
                           Padding="2"
                           BackgroundColor="White"
                           HasShadow="False">

                        <Frame CornerRadius="33"
                               Padding="0"
                               IsClippedToBounds="True"
                               HasShadow="False"
                               BorderColor="Transparent">

                            <Image Source="https://ui-avatars.com/api/?name={Binding UsuarioLogueado.Nombre}&amp;background=6C5CE7&amp;color=fff"
                                   Aspect="AspectFill" />
                        </Frame>
                    </Frame>

                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="4">
                        <Label Text="{Binding UsuarioLogueado.Nombre}"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <HorizontalStackLayout Spacing="6">
                            <BoxView Color="#686DE0"
                                     WidthRequest="12"
                                     HeightRequest="12"
                                     CornerRadius="6"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding UsuarioLogueado.Rol.Nombre}"
                                   TextColor="#DFF9FB"
                                   FontSize="14" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- ESTADÍSTICAS -->
            <Frame Margin="18,0"
                   CornerRadius="24"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="White">

                <VerticalStackLayout Spacing="22">
                    <Label Text="Estadísticas Base"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2D3436" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">
                        <Label Text="{Binding TotalProyectos}"
                               FontSize="42"
                               FontAttributes="Bold"
                               TextColor="#4834D4" />

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
                            <Label Text="Proyectos"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#636E72" />
                            <Label Text="Activos ahora"
                                   FontSize="12"
                                   TextColor="#B2BEC3" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#F1F2F6" />

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Finalizadas"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#2D3436" />
                            <Label Grid.Column="1"
                                   Text="{Binding PorcentajeGlobal, StringFormat='{0:P0}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#218C74" />
                        </Grid>

                        <ProgressBar Progress="{Binding PorcentajeGlobal}"
                                     ProgressColor="#26DE81"
                                     HeightRequest="10"
                                     ScaleY="1.3" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="En curso"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#2D3436" />
                            <Label Grid.Column="1"
                                   Text="{Binding PorcentajeEnProgreso, StringFormat='{0:P0}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#D68910" />
                        </Grid>

                        <ProgressBar Progress="{Binding PorcentajeEnProgreso}"
                                     ProgressColor="#FED330"
                                     HeightRequest="10"
                                     ScaleY="1.3" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- TÍTULO -->
            <VerticalStackLayout Margin="18,0,18,0"
                                 Spacing="4">
                <Label Text="Panel de Proyectos"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#2D3436" />
                <Label Text="Consulta, organiza y accede al detalle de cada proyecto"
                       FontSize="13"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <!-- LISTA PROYECTOS -->
            <CollectionView ItemsSource="{Binding Proyectos}"
                            Margin="18,0,18,20"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="24"
                               HasShadow="True"
                               BorderColor="Transparent"
                               Padding="0"
                               BackgroundColor="White">

                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="6"
                                         Color="#4834D4" />

                                <VerticalStackLayout Padding="18"
                                                     Spacing="14">

                                    <Label Text="{Binding Nombre}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#2D3436" />

                                    <Label Text="{Binding Descripcion}"
                                           FontSize="14"
                                           TextColor="#636E72"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3" />

                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,10,0,0">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Tareas.Count}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="#4834D4" />
                                            <Label Text="Tareas"
                                                   FontSize="15"
                                                   TextColor="#636E72" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding ProgresoCalculado, StringFormat='{0:P0}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#4834D4" />
                                    </Grid>

                                    <ProgressBar Progress="{Binding ProgresoCalculado}"
                                                 ProgressColor="#4834D4"
                                                 HeightRequest="8"
                                                 ScaleY="1.2" />

                                    <Label Text="Actualizado recientemente"
                                           FontSize="11"
                                           TextColor="#A4B0BE"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>