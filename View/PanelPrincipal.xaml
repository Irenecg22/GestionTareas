<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.PanelPrincipal"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light=#F0F2F8, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="0">

        <Border Grid.Row="0" BackgroundColor="#4834D4" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,40,40" Padding="25,30">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding FechaActual}" TextColor="#DFF9FB" FontSize="11" FontAttributes="Bold" TextTransform="Uppercase" Opacity="0.8"/>
                    <Label Text="{Binding UsuarioLogueado.Nombre, StringFormat='¡Hola, {0}! 👋'}" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Panel de control en tiempo real" TextColor="#DFF9FB" FontSize="13" />
                </VerticalStackLayout>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" BackgroundColor="#30FFFFFF" StrokeThickness="0">
                    <Label Text="🔔" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="15,15" ColumnSpacing="6">
            <Border Grid.Column="0" BackgroundColor="#E0E7FF" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding TotalProyectos}" FontSize="16" FontAttributes="Bold" TextColor="#3730A3" HorizontalOptions="Center"/>
                    <Label Text="PROYECTOS" FontSize="8" TextColor="#3730A3" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="3" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding TotalTareas}" FontSize="16" FontAttributes="Bold" TextColor="#6B21A8" HorizontalOptions="Center"/>
                    <Label Text="TAREAS" FontSize="8" TextColor="#6B21A8" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="#FEE2E2" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding TareasPendientesCount}" FontSize="16" FontAttributes="Bold" TextColor="#991B1B" HorizontalOptions="Center"/>
                    <Label Text="TO DO" FontSize="8" TextColor="#991B1B" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding TareasEnProgresoCount}" FontSize="16" FontAttributes="Bold" TextColor="#92400E" HorizontalOptions="Center"/>
                    <Label Text="DOING" FontSize="8" TextColor="#92400E" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
            
            <Border Grid.Column="4" BackgroundColor="#D1FAE5" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding PorcentajeGlobal, StringFormat='{0:P0}'}" FontSize="16" FontAttributes="Bold" TextColor="#065F46" HorizontalOptions="Center"/>
                    <Label Text="ÉXITO" FontSize="8" TextColor="#065F46" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15" Padding="20,0,20,15">
            <Grid RowDefinitions="Auto, *">
                <Label Text="Proyectos Activos" FontAttributes="Bold" FontSize="15" Margin="5,0,0,10" TextColor="{AppThemeBinding Light=#2D3436, Dark=White}"/>
                <CollectionView Grid.Row="1" ItemsSource="{Binding Proyectos}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="15" StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" StrokeThickness="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" TextColor="#4834D4"/>
                                    <Label Text="{Binding Descripcion}" FontSize="10" TextColor="Gray" MaxLines="2" />
                                    <ProgressBar Progress="{Binding ProgresoCalculado}" ProgressColor="#4834D4" HeightRequest="4"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Label Text="Mis Tareas" FontAttributes="Bold" FontSize="15" Margin="5,0,0,10" TextColor="{AppThemeBinding Light=#2D3436, Dark=White}"/>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TodasLasTareas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" StrokeThickness="0">
                                <Grid ColumnDefinitions="4, *">
                                    <BoxView BackgroundColor="#4834D4" CornerRadius="2"/>
                                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0">
                                        <Label Text="{Binding Titulo}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3436, Dark=White}"/>
                                        <Label Text="{Binding Estado}" FontSize="9" FontAttributes="Bold" TextColor="#9333EA" TextTransform="Uppercase"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Margin="20,0,20,20" Padding="15" BackgroundColor="#1E1E24" StrokeShape="RoundRectangle 20">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="ESTADÍSTICAS DEL SISTEMA" TextColor="#A29BFE" FontSize="9" FontAttributes="Bold" CharacterSpacing="1"/>
                    <Label Text="{Binding TareasFinalizadasCount, StringFormat='Tareas finalizadas acumuladas: {0}'}" 
                       TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    <Label Text="Pulsa el botón para ver el desglose detallado por proyecto." TextColor="#B2BEC3" FontSize="11"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" 
                    Text="Ver Reporte" 
                    Command="{Binding VerReporteCommand}"
                    FontSize="10" 
                    BackgroundColor="#4834D4" 
                    HeightRequest="35" 
                    CornerRadius="10"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>