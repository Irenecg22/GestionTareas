<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.LoginView"
             Title=""
             BackgroundColor="#F8F7FF">

    <Grid VerticalOptions="Center" HorizontalOptions="Fill" Padding="30">
        <VerticalStackLayout Spacing="0" 
                             HorizontalOptions="Fill" 
                             MaximumWidthRequest="600">
            <Border StrokeShape="RoundRectangle 40"
                    HeightRequest="110"
                    WidthRequest="110"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    Margin="0,0,0,25"
                    BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                </Border.Shadow>
                <Image Source="loogo.png" 
                       Aspect="AspectFit"
                       Margin="20" />
            </Border>

            <Label Text="Bienvenido"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1F2937" />

            <Label Text="Organiza tu trabajo"
                   FontSize="15"
                   Margin="0,5,0,35"
                   HorizontalOptions="Center"
                   TextColor="#6B7280" />

            <VerticalStackLayout Spacing="18" HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="5">
                    <Label Text="CORREO ELECTRÓNICO" FontSize="12" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#E5E7EB" 
                            BackgroundColor="White" 
                            >
                        <Entry Placeholder="ejemplo@correo.com" 
                               Text="{Binding Email}" 
                               Keyboard="Email" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CONTRASEÑA" FontSize="12" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#E5E7EB" 
                            BackgroundColor="White" 
                            >
                        <Entry Placeholder="••••••••" 
                               Text="{Binding Password}" 
                               IsPassword="True" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="INICIAR SESIÓN" 
                        Command="{Binding LoginCommand}" 
                        BackgroundColor="#6D28D9" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="60" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,0"
                        HorizontalOptions="Fill" />

                <Button Text="¿No tienes cuenta? Regístrate" 
                        Command="{Binding GoToRegisterCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="#6D28D9" 
                        FontSize="14" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}" 
                               Color="#6D28D9" 
                               Margin="0,15" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>