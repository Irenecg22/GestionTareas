<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.EditarPerfilView"
             x:DataType="vm:EditarPerfilViewModel"
             Title="Editar Perfil"
             BackgroundColor="{AppThemeBinding Light=#F8F7FF, Dark=#0F0F12}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <VerticalStackLayout Spacing="4">
                <Label Text="Editar Perfil" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#4C1D95, Dark=White}" />
                <Label Text="Actualiza tu información personal" 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}" 
                       Opacity="0.7"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 20" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                    StrokeThickness="0" 
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#7C3AED" Offset="0,8" Radius="15" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="NOMBRE" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#A78BFA" 
                               CharacterSpacing="1" 
                               Margin="4,0"/>
                        <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                                StrokeShape="RoundRectangle 12" 
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" 
                                Padding="12,2">
                            <Entry Text="{Binding Nombre}" 
                                   Placeholder="Tu nombre completo" 
                                   PlaceholderColor="#9CA3AF" 
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="EMAIL" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#A78BFA" 
                               CharacterSpacing="1" 
                               Margin="4,0"/>
                        <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                                StrokeShape="RoundRectangle 12" 
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" 
                                Padding="12,2">
                            <Entry Text="{Binding Email}" 
                                   Placeholder="tu@email.com" 
                                   PlaceholderColor="#9CA3AF" 
                                   Keyboard="Email"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                             Margin="0,10"/>

                    <Label Text="Cambiar Contraseña (Opcional)" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#4C1D95, Dark=White}" />

                    <Label Text="Deja estos campos vacíos si no deseas cambiar tu contraseña" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" 
                           Margin="0,-10,0,0"/>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="NUEVA CONTRASEÑA" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#A78BFA" 
                               CharacterSpacing="1" 
                               Margin="4,0"/>
                        <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                                StrokeShape="RoundRectangle 12" 
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" 
                                Padding="12,2">
                            <Entry Text="{Binding NuevaPassword}" 
                                   Placeholder="Mínimo 8 caracteres" 
                                   PlaceholderColor="#9CA3AF" 
                                   IsPassword="True"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="CONFIRMAR CONTRASEÑA" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#A78BFA" 
                               CharacterSpacing="1" 
                               Margin="4,0"/>
                        <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                                StrokeShape="RoundRectangle 12" 
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#27272A}" 
                                Padding="12,2">
                            <Entry Text="{Binding ConfirmarPassword}" 
                                   Placeholder="Repite la contraseña" 
                                   PlaceholderColor="#9CA3AF" 
                                   IsPassword="True"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <Button Grid.Column="0"
                        Text="Cancelar" 
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#3F3F46}" 
                        TextColor="{AppThemeBinding Light=#374151, Dark=White}" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        HeightRequest="50"/>

                <Button Grid.Column="1"
                        Text="Guardar Cambios" 
                        Command="{Binding GuardarCambiosCommand}"
                        BackgroundColor="#7C3AED" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        HeightRequest="50"/>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#7C3AED"
                               HeightRequest="40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
