<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.SignUpView"
             Title="SignUpView">
    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="20">
            <Label Text="Sign Up" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Create account to start messaging" HorizontalOptions="Center" TextColor="Gray"/>

            <Entry Placeholder="Nombre Completo" Text="{Binding Nombre}" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />
            <Entry Placeholder="Confirmar Password" Text="{Binding ConfirmPassword}" IsPassword="True" />

            <Button Text="Create Account" 
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="15"
                    HeightRequest="55"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}" HorizontalOptions="Center" Color="#2196F3" />

            <Button Text="¿Ya tienes cuenta? Login"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>