<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.SignUpView"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="20"
                             VerticalOptions="Center">

            <Label Text="Crear cuenta"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#111827" />

            <Label Text="Regístrate para empezar a gestionar tus proyectos"
                   HorizontalTextAlignment="Center"
                   TextColor="#6B7280" />

            <Frame IsVisible="{Binding HasError}"
                   BackgroundColor="#FEE2E2"
                   BorderColor="#EF4444"
                   CornerRadius="8"
                   Padding="12"
                   Margin="0,0,0,10">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626"
                       FontSize="14" />
            </Frame>

            <Entry Placeholder="Nombre completo"
                   Text="{Binding Nombre}" />

            <Entry Placeholder="Email"
                   Text="{Binding Email}"
                   Keyboard="Email" />

            <Entry Placeholder="Contraseña"
                   Text="{Binding Password}"
                   IsPassword="True" />

            <Entry Placeholder="Confirmar contraseña"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True" />

            <Button Text="Crear cuenta"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="52" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#4F46E5" />

            <Button Text="¿Ya tienes cuenta? Iniciar sesión"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#4F46E5" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>