<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionTareas.View.SignUpView"
             Title="Registro"
             BackgroundColor="#F8F7FF">

    <Grid VerticalOptions="Center" HorizontalOptions="Fill" Padding="30">
        <VerticalStackLayout Spacing="0" 
                             MaximumWidthRequest="600" 
                             HorizontalOptions="Fill">

            <Label Text="Crear cuenta" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#1F2937" />

            <Label Text="Regístrate para empezar a gestionar tus proyectos" 
                   HorizontalTextAlignment="Center" 
                   FontSize="15" 
                   TextColor="#6B7280" 
                   Margin="0,5,0,25" />

            <Frame IsVisible="{Binding HasError}" 
                   BackgroundColor="#FEE2E2" 
                   BorderColor="#EF4444" 
                   CornerRadius="8" 
                   Padding="12" 
                   Margin="0,0,0,20">
                <Label Text="{Binding ErrorMessage}" 
                       TextColor="#DC2626" 
                       FontSize="13" />
            </Frame>

            <VerticalStackLayout Spacing="15" HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="5">
                    <Label Text="NOMBRE COMPLETO" FontSize="11" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#DDD6FE" 
                            BackgroundColor="White"
                            HorizontalOptions="Fill">
                        <Entry Placeholder="Tu nombre" 
                               Text="{Binding Nombre}" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CORREO ELECTRÓNICO" FontSize="11" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#DDD6FE" 
                            BackgroundColor="White"
                            HorizontalOptions="Fill">
                        <Entry Placeholder="correo@ejemplo.com" 
                               Text="{Binding Email}" 
                               Keyboard="Email" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#DDD6FE" 
                            BackgroundColor="White" 
                            HorizontalOptions="Fill">
                        <Entry Placeholder="••••••••" 
                               Text="{Binding Password}" 
                               IsPassword="True" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CONFIRMAR CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#4B5563" Margin="5,0,0,0" />
                    <Border StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#DDD6FE" 
                            BackgroundColor="White" 
                            HorizontalOptions="Fill">
                        <Entry Placeholder="••••••••" 
                               Text="{Binding ConfirmPassword}" 
                               IsPassword="True" 
                               HeightRequest="60" 
                               TextColor="#111827"
                               HorizontalOptions="Fill" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="CREAR CUENTA" 
                        Command="{Binding RegisterCommand}" 
                        BackgroundColor="#5B21B6" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="62" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,0"
                        HorizontalOptions="Fill" />

                <Button Text="¿Ya tienes cuenta? Inicia sesión" 
                        Command="{Binding GoToLoginCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="#4B5563" 
                        FontSize="14" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}" 
                               Color="#5B21B6" 
                               Margin="0,15" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>