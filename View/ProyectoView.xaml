<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.ProyectoView"
             x:Name="ProyectoPage"
             Title="Proyectos"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,30,30" HeightRequest="160">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.1" />
                    <GradientStop Color="#7C3AED" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Padding="20" RowDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#FFFFFF" Opacity="0.2" Stroke="White" StrokeThickness="2">
                        <Label Text="BU" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="White" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mis Proyectos" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Panel de gestión" FontSize="12" TextColor="#E0E7FF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button Grid.Row="1" Text="+ NUEVO PROYECTO" Clicked="OnNuevoProyectoClicked" 
                        BackgroundColor="White" TextColor="#4F46E5" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="15" Padding="20,15,20,10">
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" Padding="12,8" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Total:" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" VerticalOptions="Center"/>
                    <Label Text="{Binding Proyectos.Count}" FontAttributes="Bold" TextColor="#4F46E5" FontSize="16"/>
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" Padding="12,8" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" Color="#10B981" CornerRadius="4" VerticalOptions="Center"/>
                    <Label Text="Activos" FontAttributes="Bold" TextColor="#10B981" FontSize="13" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Proyectos}" 
                        SelectionMode="None"
                        VerticalOptions="Start"
                        HeightRequest="300">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="20,10,5,20" 
                            WidthRequest="300" 
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="20" 
                            StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=Black, Dark=White}" Offset="0,4" Radius="8" Opacity="0.08" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Nombre}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" 
                                       LineBreakMode="TailTruncation" />
                                <BoxView Grid.Column="1" WidthRequest="10" HeightRequest="10" 
                                         Color="#10B981" CornerRadius="5" VerticalOptions="Center"/>
                            </Grid>

                            <Label Text="{Binding Descripcion}" 
                                   FontSize="13" 
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#B2BEC3}" 
                                   MaxLines="3" 
                                   HeightRequest="60" />

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Equipo" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Tareas}" Wrap="NoWrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,0" 
                                                    BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#2E1065}" 
                                                    Padding="8,4" StrokeShape="RoundRectangle 8">
                                                <Label Text="{Binding UsuarioAsignado.Nombre}" FontSize="10" 
                                                       TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}" FontAttributes="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                                <Button Text="Eliminar" 
                                        Command="{Binding BindingContext.EliminarProyectoCommand, Source={x:Reference ProyectoPage}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{AppThemeBinding Light=#FFF1F2, Dark=#450A0A}" 
                                        TextColor="{AppThemeBinding Light=#E11D48, Dark=#FCA5A5}" 
                                        FontSize="11" HeightRequest="35" CornerRadius="8" />

                                <Button Grid.Column="1" Text="Detalles"
                                        Command="{Binding BindingContext.VerDetallesCommand, Source={x:Reference ProyectoPage}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#4F46E5" TextColor="White" 
                                        FontSize="11" HeightRequest="35" CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>