<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
            x:Class="GestionTareas.View.ProyectoView">

    <Grid ColumnDefinitions="220, *" ColumnSpacing="0">
        <VerticalStackLayout Grid.Column="0" BackgroundColor="White" Padding="20, 40, 20, 20" Spacing="15">
            <Button Text="Proyectos" BackgroundColor="#F3F4F6" TextColor="#7C3AED" FontAttributes="Bold" HorizontalOptions="Fill" />
            
        </VerticalStackLayout>

        <Grid Grid.Column="1" RowDefinitions="Auto, *" Padding="30">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <VerticalStackLayout>
                    <Label Text="Mis Proyectos" FontSize="28" FontAttributes="Bold" TextColor="#111827" />
                    <Label Text="Gestiona tus equipos y entregas" TextColor="Gray" />
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="+ Nuevo Proyecto" BackgroundColor="#7C3AED" TextColor="White" CornerRadius="8" HeightRequest="45" Padding="20,0" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Proyectos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="20" Margin="0,0,0,15">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    <Label Text="{Binding Descripcion}" FontSize="14" TextColor="#6B7280" />

                                    <HorizontalStackLayout Spacing="5" Margin="0,10,0,0">
                                        <Label Text="Personal asignado:" FontSize="12" VerticalOptions="Center" Margin="0,0,5,0"/>
                                        <FlexLayout BindableLayout.ItemsSource="{Binding Tareas}" Wrap="Wrap">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#EDE9FE" Padding="8,2" Margin="0,0,5,0">
                                                        <Label Text="{Binding UsuarioAsignado.Nombre}" FontSize="10" TextColor="#7C3AED" FontAttributes="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Button Grid.Column="1" Text="Detalles" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProyectoViewModel}}, Path=VerDetallesCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F3F4F6" TextColor="#7C3AED" CornerRadius="8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>