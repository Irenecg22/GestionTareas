<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionTareas.ViewModel"
             x:Class="GestionTareas.View.ProyectoView"
             x:Name="ProyectoPage"
             Title="Proyectos"
             BackgroundColor="#F3F4F6">
    
    <ScrollView>
        <VerticalStackLayout Padding="18"
                             Spacing="18">

            <!-- CABECERA -->
            <Border BackgroundColor="#4F46E5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,28,28"
                    Padding="18">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="72"
                                HeightRequest="72"
                                BackgroundColor="#6366F1"
                                Stroke="White"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 36"
                                VerticalOptions="Center">
                            <Label Text="BU"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="4">
                            <Label Text="Mis Proyectos"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Gestiona tus equipos y entregas"
                                   FontSize="13"
                                   TextColor="#E0E7FF" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="+ Nuevo Proyecto"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <!-- PANEL RESUMEN -->
            <Label Text="Proyectos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#7C3AED" />

            <Border BackgroundColor="#F5F3FF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Padding="18">

                <VerticalStackLayout Spacing="18">

                    <Label Text="Vista general"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />

                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sección activa"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                            <Label Text="Proyectos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#7C3AED" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1"
                             Color="#E5E7EB" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="14">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Total"
                               FontSize="14"
                               TextColor="#374151" />

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Proyectos.Count}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#7C3AED" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Estado"
                               FontSize="14"
                               TextColor="#374151" />

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="Activos"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#10B981" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- TÍTULO SECCIÓN -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Panel de Proyectos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />
                <Label Text="Consulta, organiza y accede al detalle de cada proyecto"
                       FontSize="13"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <!-- LISTA -->
            <CollectionView ItemsSource="{Binding Proyectos}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="18">

                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,3"
                                        Radius="8"
                                        Opacity="0.08" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Nombre}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#111827" />

                                    <Label Text="{Binding Descripcion}"
                                           FontSize="14"
                                           TextColor="#6B7280"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="#FEF3C7"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12,6">
                                        <Label Text="En curso"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#D97706" />
                                    </Border>

                                    <Border BackgroundColor="#EDE9FE"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12,6">
                                        <Label Text="Proyecto"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#7C3AED" />
                                    </Border>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Personal asignado"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#374151" />

                                    <FlexLayout BindableLayout.ItemsSource="{Binding Tareas}"
                                                Wrap="Wrap"
                                                Direction="Row"
                                                AlignItems="Start"
                                                JustifyContent="Start">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#EDE9FE"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16"
                                                        Padding="10,6"
                                                        Margin="0,0,8,8">
                                                    <Label Text="{Binding UsuarioAsignado.Nombre}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#7C3AED" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <Button Text="Detalles"
                                        Command="{Binding BindingContext.VerDetallesCommand, Source={x:Reference ProyectoPage}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F5F3FF"
                                        TextColor="#7C3AED"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>