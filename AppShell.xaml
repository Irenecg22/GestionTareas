<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestionTareas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GestionTareas"
    xmlns:v="clr-namespace:GestionTareas.View"
    Title="GestionTareas">

    <ShellContent
Title="Proyectos"
ContentTemplate="{DataTemplate v:ProyectoView}"
Route="proyectosPage" />

    <ShellContent
        Title="Tareas"
        ContentTemplate="{DataTemplate v:TareaView}"
        Route="tareasPage" />

    <ShellContent
    Title="Ajustes"
    ContentTemplate="{DataTemplate v:SettingsView}"
    Route="settingsPage" />


</Shell>
