<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestionTareas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:GestionTareas.View"
    Title="GestionTareas">

    <ShellContent 
        Title="Dashboard"
        Icon="dashboard.png"
        ContentTemplate="{DataTemplate v:PanelPrincipal}" 
        Route="dashboardPage" />

    <ShellContent 
        Title="Proyectos"
        Icon="folder.png"
        ContentTemplate="{DataTemplate v:ProyectoView}" 
        Route="proyectosPage" />

    <ShellContent
        Title="Tareas"
        Icon="task.png"
        ContentTemplate="{DataTemplate v:TareaView}"
        Route="tareasPage" />

    <ShellContent
        Title="Reportes"
        Icon="bar_chart.png"
        ContentTemplate="{DataTemplate v:ReportesView}"
        Route="reportesPage" />

    <ShellContent
        Title="Ajustes"
        Icon="settings.png"
        ContentTemplate="{DataTemplate v:SettingsView}"
        Route="settingsPage" />

</Shell>